{
  "name": "vidvazhni",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "node tools/validate-data.mjs",
    "icons": "node tools/make-icons.mjs",
    "models": "node tools/optimize-models.mjs",
    "ui-assets": "node tools/ui-assets.mjs",
    "play": "vite build --outDir dist-play --emptyOutDir && vite preview --outDir dist-play --host --port 5181 --strictPort"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "ajv": "^8.20.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
