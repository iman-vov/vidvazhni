{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scenario",
  "definitions": {
    "eventAction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "spawn" },
            "monster": { "type": "string", "minLength": 1 },
            "by": {
          "type": "object",
          "properties": {
            "2": { "enum": ["normal", "elite"] },
            "3": { "enum": ["normal", "elite"] },
            "4": { "enum": ["normal", "elite"] }
          },
          "additionalProperties": false
        },
            "hexes": { "type": "array", "items": { "$ref": "#/definitions/hex" }, "minItems": 1 },
            "count": { "type": "integer", "minimum": 1 },
            "burst": { "type": "boolean" },
            "tag": { "type": "string", "minLength": 1 },
            "asleep": { "const": true }
          },
          "required": ["type", "monster", "by", "hexes"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "openDoor" }, "hex": { "$ref": "#/definitions/hex" } },
          "required": ["type", "hex"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "story" }, "text": { "type": "string", "minLength": 1 } },
          "required": ["type", "text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "coins" }, "coins": { "type": "integer", "minimum": 1 } },
          "required": ["type", "coins"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "setGoal" }, "goal": { "$ref": "#/properties/goal" } },
          "required": ["type", "goal"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "wake" }, "room": { "type": "string", "minLength": 1 } },
          "required": ["type"],
          "additionalProperties": false
        }
      ]
    },
    "drop": {
      "description": "What a killed figure may leave (docs/design/camp.md «Звідки здобич»).",
      "type": "object",
      "properties": {
        "coins": { "type": "integer", "minimum": 1 },
        "coinChance": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "items": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "itemChance": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "required": [],
      "additionalProperties": false,
      "dependencies": { "coinChance": ["coins"], "itemChance": ["items"] }
    },
    "surface": { "enum": ["planks", "flagstones", "cobblestone", "worn-stone", "forest-floor", "grass", "roots", "mud", "wet-grass", "walkway", "rock"] },
    "hex": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
    "breakable": {
      "description": "Heroes break it with attacks (no modifier draw); gone at 0 hp.",
      "type": "object",
      "properties": { "hp": { "type": "integer", "minimum": 1 } },
      "required": ["hp"],
      "additionalProperties": false
    },
    "condition": { "enum": ["poison", "wound", "immobilize", "disarm", "stun", "muddle", "invisible", "strengthen"] },
    "element": { "enum": ["fire", "ice", "air", "earth", "light", "dark"] },
    "target": {
      "enum": [
        "self",
        "ally",
        "allyOrSelf",
        "adjacentAllies",
        "alliesInRadius",
        "adjacentEnemies",
        "enemiesInRadius",
        "summon"
      ]
    },
    "area": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "shape": { "const": "arc" }, "size": { "const": 3 } },
          "required": ["shape", "size"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "shape": { "const": "line" },
            "length": { "type": "integer", "minimum": 1 },
            "fromSelf": { "const": true }
          },
          "required": ["shape", "length", "fromSelf"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "shape": { "const": "triangle" }, "size": { "const": 3 } },
          "required": ["shape", "size"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "shape": { "const": "targetAndAdjacent" } },
          "required": ["shape"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "shape": { "const": "allAdjacent" } },
          "required": ["shape"],
          "additionalProperties": false
        }
      ]
    },
    "duration": {
      "oneOf": [
        { "enum": ["round", "scenario", "persistent"] },
        {
          "type": "object",
          "properties": { "uses": { "type": "integer", "minimum": 1 } },
          "required": ["uses"],
          "additionalProperties": false
        }
      ]
    },
    "consume": {
      "type": "object",
      "properties": {
        "element": { "enum": ["fire", "ice", "air", "earth", "light", "dark", "any"] },
        "count": { "type": "integer", "minimum": 1 },
        "add": {
          "type": "object",
          "properties": {
            "value": { "type": "integer" },
            "range": { "type": "integer" },
            "targets": { "type": "integer" },
            "push": { "type": "integer" },
            "pierce": { "type": "integer" },
            "move": { "type": "integer" }
          },
          "required": [],
          "additionalProperties": false
        },
        "conditions": { "type": "array", "items": { "$ref": "#/definitions/condition" } },
        "replaceConditions": { "type": "array", "items": { "$ref": "#/definitions/condition" } },
        "then": { "type": "array", "items": { "$ref": "#/definitions/step" } },
        "area": { "$ref": "#/definitions/area" },
        "extraTarget": { "type": "boolean" },
        "curse": { "type": "boolean" }
      },
      "required": ["element"],
      "additionalProperties": false
    },
    "attackBonus": {
      "type": "object",
      "properties": {
        "if": { "enum": ["allyAdjacentToTarget", "targetHasNoOtherEnemyAdjacent", "sameTypeAdjacentToTarget"] },
        "attack": { "type": "integer" },
        "advantage": { "type": "boolean" }
      },
      "required": ["if"],
      "additionalProperties": false
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "move" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "value": { "type": "integer" },
            "jump": { "type": "boolean" },
            "fly": { "type": "boolean" },
            "straightLine": { "type": "boolean" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "attack" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "value": { "type": "integer" },
            "range": { "type": "integer" },
            "targets": { "type": "integer", "minimum": 1 },
            "area": { "$ref": "#/definitions/area" },
            "pierce": { "type": "integer", "minimum": 0 },
            "push": { "type": "integer", "minimum": 0 },
            "pull": { "type": "integer", "minimum": 0 },
            "conditions": { "type": "array", "items": { "$ref": "#/definitions/condition" } },
            "bless": { "type": "boolean" },
            "curse": { "type": "boolean" },
            "advantage": { "type": "boolean" },
            "bonuses": { "type": "array", "items": { "$ref": "#/definitions/attackBonus" } },
            "targetAll": { "enum": ["adjacentEnemies"] }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "heal" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "value": { "type": "integer", "minimum": 1 },
            "target": { "$ref": "#/definitions/target" },
            "range": { "type": "integer", "minimum": 0 },
            "radius": { "type": "integer", "minimum": 0 },
            "removeNegative": { "type": "integer", "minimum": 1 },
            "bless": { "type": "boolean" }
          },
          "required": ["type", "value", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "shield" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "value": { "type": "integer", "minimum": 1 },
            "target": { "$ref": "#/definitions/target" },
            "duration": { "$ref": "#/definitions/duration" },
            "range": { "type": "integer", "minimum": 0 }
          },
          "required": ["type", "value", "target", "duration"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "retaliate" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "value": { "type": "integer", "minimum": 1 },
            "range": { "type": "integer", "minimum": 0 },
            "duration": { "$ref": "#/definitions/duration" }
          },
          "required": ["type", "value", "duration"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "provoke" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "radius": { "type": "integer", "minimum": 1 }
          },
          "required": ["type", "radius"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "condition" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "condition": { "$ref": "#/definitions/condition" },
            "target": { "$ref": "#/definitions/target" },
            "range": { "type": "integer", "minimum": 0 },
            "radius": { "type": "integer", "minimum": 0 }
          },
          "required": ["type", "condition", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "bless" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "target": { "$ref": "#/definitions/target" },
            "range": { "type": "integer", "minimum": 0 }
          },
          "required": ["type", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "push" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "value": { "type": "integer", "minimum": 1 },
            "target": { "$ref": "#/definitions/target" }
          },
          "required": ["type", "value", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "pull" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "value": { "type": "integer", "minimum": 1 },
            "target": { "$ref": "#/definitions/target" },
            "range": { "type": "integer", "minimum": 0 }
          },
          "required": ["type", "value", "target"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "infuse" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "element": { "enum": ["fire", "ice", "air", "earth", "light", "dark", "any"] }
          },
          "required": ["type", "element"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "loot" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "range": { "type": "integer", "minimum": 0 }
          },
          "required": ["type", "range"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "summon" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "summon": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 1 },
            "rank": { "enum": ["normal", "elite"] }
          },
          "required": ["type", "summon"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "trap" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "damage": { "type": "integer", "minimum": 1 },
            "conditions": { "type": "array", "items": { "$ref": "#/definitions/condition" } }
          },
          "required": ["type", "damage"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "active" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "uses": { "type": "integer", "minimum": 1 },
            "on": { "enum": ["attack", "rangedAttack", "attacked"] },
            "grant": {
              "type": "object",
              "properties": {
                "advantage": { "type": "boolean" },
                "conditions": { "type": "array", "items": { "$ref": "#/definitions/condition" } },
                "shield": { "type": "integer", "minimum": 1 },
                "range": { "type": "integer", "minimum": 1 }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": ["type", "uses", "on", "grant"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "teleport" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "range": { "type": "integer", "minimum": 1 }
          },
          "required": ["type", "range"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "special" },
            "xp": { "type": "integer", "minimum": 0 },
            "consume": { "$ref": "#/definitions/consume" },
            "name": { "type": "string", "minLength": 1 },
            "params": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean"] } }
          },
          "required": ["type", "name"],
          "additionalProperties": false
        }
      ]
    },
    "steps": { "type": "array", "items": { "$ref": "#/definitions/step" }, "minItems": 1 },
    "half": {
      "type": "object",
      "properties": {
        "steps": { "$ref": "#/definitions/steps" },
        "loss": { "type": "boolean" },
        "active": { "type": "boolean" }
      },
      "required": ["steps"],
      "additionalProperties": false
    },
    "monsterCard": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "initiative": { "type": "integer", "minimum": 1, "maximum": 99 },
        "shuffle": { "type": "boolean" },
        "steps": { "$ref": "#/definitions/steps" },
        "if": { "enum": ["selfHpAtMostHalf", "twoOrMoreHeroesAdjacent"] },
        "otherwise": { "$ref": "#/definitions/steps" }
      },
      "required": ["id", "initiative", "steps"],
      "additionalProperties": false,
      "dependencies": { "if": ["otherwise"], "otherwise": ["if"] }
    },
    "monsterStats": {
      "type": "object",
      "properties": {
        "hp": { "type": "integer", "minimum": 1 },
        "move": { "type": "integer", "minimum": 0 },
        "attack": { "type": "integer", "minimum": 0 },
        "range": { "type": "integer", "minimum": 1 },
        "shield": { "type": "integer", "minimum": 1 },
        "retaliate": { "type": "integer", "minimum": 1 },
        "onAttack": { "type": "array", "items": { "$ref": "#/definitions/condition" } },
        "flying": { "type": "boolean" }
      },
      "required": ["hp", "move", "attack"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^s[0-9]+$" },
    "number": { "type": "integer", "minimum": 1 },
    "goal": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "type": { "const": "killAll" } },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "reachExit" },
            "hexes": { "type": "array", "items": { "$ref": "#/definitions/hex" }, "minItems": 1 },
            "zone": { "type": "string", "minLength": 1 }
          },
          "required": ["type"],
          "oneOf": [{ "required": ["hexes"] }, { "required": ["zone"] }],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "killBoss" }, "boss": { "type": "string", "minLength": 1 } },
          "required": ["type", "boss"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "carryItem" },
            "item": { "type": "string", "minLength": 1 },
            "to": { "type": "array", "items": { "$ref": "#/definitions/hex" }, "minItems": 1 },
            "zone": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "item"],
          "oneOf": [{ "required": ["to"] }, { "required": ["zone"] }],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "survive" }, "rounds": { "type": "integer", "minimum": 1 } },
          "required": ["type", "rounds"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "defend" },
            "zone": { "type": "string", "minLength": 1 },
            "rounds": { "type": "integer", "minimum": 1 },
            "counter": { "type": "integer", "minimum": 1 },
            "counterName": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "zone", "rounds"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "escape" },
            "hexes": { "type": "array", "items": { "$ref": "#/definitions/hex" }, "minItems": 1 },
            "zone": { "type": "string", "minLength": 1 },
            "rounds": { "type": "integer", "minimum": 1 }
          },
          "required": ["type", "rounds"],
          "oneOf": [{ "required": ["hexes"] }, { "required": ["zone"] }],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "collect" },
            "kind": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 1 },
            "to": { "type": "array", "items": { "$ref": "#/definitions/hex" }, "minItems": 1 },
            "zone": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "kind", "count"],
          "oneOf": [{ "required": ["to"] }, { "required": ["zone"] }],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "escort" },
            "npc": { "type": "string", "minLength": 1 },
            "to": { "type": "array", "items": { "$ref": "#/definitions/hex" }, "minItems": 1 },
            "zone": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "npc"],
          "oneOf": [{ "required": ["to"] }, { "required": ["zone"] }],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "destroy" }, "kind": { "type": "string", "minLength": 1 } },
          "required": ["type", "kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "race" },
            "rival": { "type": "string", "minLength": 1 },
            "to": { "type": "array", "items": { "$ref": "#/definitions/hex" }, "minItems": 1 },
            "zone": { "type": "string", "minLength": 1 },
            "all": { "type": "boolean" }
          },
          "required": ["type", "rival"],
          "oneOf": [{ "required": ["to"] }, { "required": ["zone"] }],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "protect" },
            "object": { "type": "string", "minLength": 1 },
            "rounds": { "type": "integer", "minimum": 1 }
          },
          "required": ["type", "object", "rounds"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "objectStates" },
            "objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": { "id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "minLength": 1 } },
                "required": ["id", "state"],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "hexes": { "type": "array", "items": { "$ref": "#/definitions/hex" }, "minItems": 1 },
            "zone": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "objects"],
          "additionalProperties": false
        }
      ]
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "hex": { "$ref": "#/definitions/hex" },
          "hp": { "type": "integer", "minimum": 1 },
          "move": { "type": "integer", "minimum": 0 },
          "initiative": { "type": "integer", "minimum": 1, "maximum": 99 }
        },
        "required": ["id", "hex", "hp", "move"],
        "additionalProperties": false
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "hexes": { "type": "array", "items": { "$ref": "#/definitions/hex" }, "minItems": 1 }
        },
        "required": ["id", "hexes"],
        "additionalProperties": false
      }
    },
    "lose": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "type": { "const": "roundLimit" }, "rounds": { "type": "integer", "minimum": 1 } },
        "required": ["type", "rounds"],
        "additionalProperties": false
      }
    },
    "secondary": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "check": { "enum": ["chestOpened", "noneExhausted", "objectState", "withinRounds", "noMirrorBroken", "objectIntact", "noAlarm", "loomsBrokenBeforeHalf", "counterKept"] },
          "params": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean"] } },
          "reward": {
            "type": "object",
            "properties": {
              "xp": { "type": "integer", "minimum": 0 },
              "gold": { "type": "integer", "minimum": 0 },
              "unlock": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Scenarios opened on a win with this goal met (a secret mission's key)." }
            },
            "additionalProperties": false
          }
        },
        "required": ["id", "check", "reward"],
        "additionalProperties": false
      }
    },
