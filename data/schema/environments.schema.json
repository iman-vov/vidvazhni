{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Environment",
  "description": "What surrounds the playable hexes of a scenario location (src/render/environment). Piece ids are the kit ids in src/render/environment/pieces.ts.",
  "definitions": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "edge": { "enum": ["stone", "tower", "timber", "forest", "shore", "cave", "mine", "cliff", "forge"] },
    "piece": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "weighted": {
      "type": "array",
      "items": {
        "type": "array",
        "items": [{ "$ref": "#/definitions/piece" }, { "type": "number", "exclusiveMinimum": 0 }],
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "scenarios": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "edge": { "$ref": "#/definitions/edge" },
    "rooms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": { "edge": { "$ref": "#/definitions/edge" } },
        "required": ["edge"],
        "additionalProperties": false
      }
    },
    "divider": { "enum": ["stone", "brick", "planks", "palisade", "wattle", "hedge", "rock-ridge", "stone-fence", "reed-fence"] },
    "ground": {
      "type": "object",
      "properties": {
        "texture": { "type": "string" },
        "tint": { "$ref": "#/definitions/color" },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "water": { "type": "number", "minimum": 0, "maximum": 1 },
        "waterColor": { "$ref": "#/definitions/color" },
        "waterFlow": { "description": "Flowing water drifts from the entrance; still water (default) only shimmers.", "enum": ["still", "flowing"] }
      },
      "required": ["tint"],
      "additionalProperties": false
    },
    "kits": { "description": "Blender kit models (env-<location>) to borrow pieces from, after the location's own.", "type": "array", "items": { "type": "string", "pattern": "^env-[a-z0-9-]+$" } },
    "surface": { "description": "Default look of the hexes; a room's surface in the scenario wins.", "enum": ["planks", "flagstones", "cobblestone", "worn-stone", "forest-floor", "grass", "roots", "mud", "wet-grass", "walkway", "rock"] },
    "boundary": { "description": "Default look of thin walls between rooms; a room's boundary wins.", "enum": ["walls", "reeds", "thicket", "rocks", "logs"] },
    "walls": {
      "type": "object",
      "properties": {
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "low": { "type": "number", "exclusiveMinimum": 0 },
        "alt": { "type": "integer", "minimum": 0 },
        "inner": { "$ref": "#/definitions/color" },
        "sconce": {
          "description": "A piece hung on the inner face of every n-th full wall segment (a torch in a bracket).",
          "type": "object",
          "properties": { "piece": { "type": "string" }, "every": { "type": "integer", "minimum": 1 } },
          "required": ["piece", "every"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "palette": { "type": "object", "additionalProperties": { "$ref": "#/definitions/color" } },
    "light": {
      "type": "object",
      "properties": {
        "sky": { "$ref": "#/definitions/color" },
        "ground": { "$ref": "#/definitions/color" },
        "hemi": { "type": "number", "minimum": 0 },
        "sun": { "$ref": "#/definitions/color" },
        "sunIntensity": { "type": "number", "minimum": 0 },
        "env": { "type": "number", "minimum": 0 },
        "point": {
          "type": "object",
          "properties": {
            "color": { "$ref": "#/definitions/color" },
            "intensity": { "type": "number", "minimum": 0 },
            "distance": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["color", "intensity", "distance"],
          "additionalProperties": false
        }
      },
      "required": ["sky", "ground", "hemi", "sun", "sunIntensity"],
      "additionalProperties": false
    },
    "fog": {
      "type": "object",
      "properties": {
        "color": { "$ref": "#/definitions/color" },
        "glow": { "$ref": "#/definitions/color" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "exclusiveMinimum": 0 },
        "morok": { "$ref": "#/definitions/color" },
        "morokOpacity": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["color", "start", "end", "morok", "morokOpacity"],
      "additionalProperties": false
    },
    "weather": {
      "description": "Particles blown across the location: snow, dust or rising sparks; count at high quality.",
      "type": "object",
      "properties": {
        "kind": { "enum": ["snow", "dust", "sparks"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "color": { "$ref": "#/definitions/color" },
        "wind": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
      },
      "required": ["kind", "count", "color", "wind"],
      "additionalProperties": false
    },
    "entrance": { "oneOf": [{ "$ref": "#/definitions/piece" }, { "type": "null" }] },
    "exit": { "oneOf": [{ "$ref": "#/definitions/piece" }, { "type": "null" }] },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "piece": { "$ref": "#/definitions/piece" }, "room": { "type": "string" } },
        "required": ["piece", "room"],
        "additionalProperties": false
      }
    },
    "propModels": {
      "description": "Prop models (assets/models/<model>/) that replace a piece, obstacle, object look or tile thing (chest, door, trap) once the model exists; procedural otherwise.",
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/piece" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/definitions/piece" },
          {
            "type": "object",
            "properties": {
              "model": { "$ref": "#/definitions/piece" },
              "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 },
              "rotY": { "type": "number", "minimum": -360, "maximum": 360 },
              "stack": { "type": "integer", "minimum": 1, "maximum": 4 }
            },
            "required": ["model"],
            "additionalProperties": false
          }
        ]
      }
    },
    "obstacles": {
      "description": "Set pieces that stand on scenario obstacles of a model, picked per hex so neighbours differ.",
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
    },
    "dressing": {
      "type": "object",
      "properties": {
        "ring": { "$ref": "#/definitions/weighted" },
        "outside": { "$ref": "#/definitions/weighted" },
        "far": { "$ref": "#/definitions/weighted" },
        "density": { "type": "number", "minimum": 0, "maximum": 1 },
        "anchors": { "description": "Pieces that always stand in the ring, spread along the far and side walls (count instead of weight).", "$ref": "#/definitions/weighted" },
        "sets": {
          "description": "Groups placed instead of single ring props. Frame: x along the wall, z out from it toward the board.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "weight": { "type": "number", "exclusiveMinimum": 0 },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "piece": { "type": "string" },
                    "x": { "type": "number" },
                    "z": { "type": "number" },
                    "on": { "type": "integer", "minimum": 0 },
                    "tilt": { "type": "number" },
                    "align": { "type": "boolean" }
                  },
                  "required": ["piece", "x", "z"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["weight", "items"],
            "additionalProperties": false
          }
        }
      },
      "required": ["ring"],
      "additionalProperties": false
    }
  },
  "required": ["id", "scenarios", "edge", "ground", "light", "fog", "dressing"],
  "additionalProperties": false
}
