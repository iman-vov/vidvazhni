{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Story texts for one language",
  "type": "object",
  "required": ["lang", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "lang": { "enum": ["uk", "de", "en"] },
    "scenarios": {
      "type": "object",
      "propertyNames": { "pattern": "^s[0-9]+$" },
      "additionalProperties": { "$ref": "#/definitions/scenario" }
    }
  },
  "definitions": {
    "heroId": { "enum": ["warden", "wind-archer", "herbalist", "rogue", "elementalist", "tinker"] },
    "line": {
      "type": "object",
      "required": ["id", "speaker", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]+\\.[a-z0-9.-]+$" },
        "speaker": {
          "description": "narrator/marta/miller/shadowhand/lina/theo/flip/hammerfist; 'hero' = a party hero picked by 'pick', using 'variants'; a hero id = plays only if that hero is in the party",
          "anyOf": [
            { "enum": ["narrator", "marta", "miller", "shadowhand", "lina", "theo", "flip", "hammerfist", "hero"] },
            { "$ref": "#/definitions/heroId" }
          ]
        },
        "pick": { "enum": ["random", "actor"] },
        "text": { "type": "string", "minLength": 1 },
        "variants": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/heroId" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "if": { "properties": { "speaker": { "const": "hero" } } },
      "then": {
        "required": ["pick", "variants"],
        "properties": { "variants": { "required": ["warden", "wind-archer", "herbalist", "rogue", "elementalist", "tinker"] } }
      }
    },
    "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/line" } },
    "trigger": {
      "type": "object",
      "required": ["on", "arg"],
      "additionalProperties": false,
      "properties": {
        "on": { "enum": ["roomRevealed", "doorOpened", "round", "bossHalfHp", "monsterKilled"] },
        "arg": { "type": ["string", "integer"] }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["intro", "beats", "outro", "epilogue"],
      "additionalProperties": false,
      "properties": {
        "intro": { "$ref": "#/definitions/lines" },
        "beats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "trigger", "lines"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "trigger": { "$ref": "#/definitions/trigger" },
              "lines": { "$ref": "#/definitions/lines" }
            }
          }
        },
        "outro": {
          "type": "object",
          "required": ["victory", "defeat"],
          "additionalProperties": false,
          "properties": {
            "victory": { "$ref": "#/definitions/lines" },
            "defeat": { "$ref": "#/definitions/lines" }
          }
        },
        "epilogue": {
          "allOf": [
            { "$ref": "#/definitions/line" },
            { "properties": { "speaker": { "const": "marta" } } }
          ]
        }
      }
    }
  }
}
